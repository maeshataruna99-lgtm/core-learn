{
  "name": "core-learn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "validate": "node scripts/validate.ts && node scripts/validate-wiki.ts &&node scripts/verify-output.ts && node scripts/verify-bugs.ts",
    "test": "vitest run",
    "build:deploy": "vue-tsc --noEmit && vite build"
  },
  "dependencies": {
    "shiki": "^4.5.0",
    "vite-plugin-pwa": "^2.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^5.2.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^9.32.0",
    "fast-check": "^3.23.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": "24.x"
  }
}
